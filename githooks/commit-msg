#!/bin/sh
# 37writes-claude-kit commit-msg
# 형식: type(scope): 한국어 요약   예) feat(auth): 소셜 로그인 추가
# 급할 때 우회: git commit --no-verify

msg_file="$1"
first=$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n 1)

# git이 자동으로 만드는 메시지는 통과
case "$first" in
  Merge*|Revert*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
if printf '%s\n' "$first" | grep -Eq "^($types)(\([A-Za-z0-9._/-]+\))?!?: .+"; then
  exit 0
fi

cat >&2 <<MSG
✖ 커밋 메시지 형식 위반 (37writes-kit)

  입력: $first

  형식: type(scope): 요약
  예시: feat(auth): 소셜 로그인 추가
        fix(api): 토큰 만료 시 500 오류 수정

  type: feat 기능 | fix 버그 | docs 문서 | refactor 구조개선 | test 테스트
        perf 성능 | style 포맷 | build 빌드 | ci CI | chore 기타 | revert 되돌림
  scope는 생략 가능, 영어 소문자 권장

  급할 때 우회: git commit --no-verify
MSG
exit 1
